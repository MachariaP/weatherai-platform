# Copy to .env and fill in real values. Never commit .env.
WEATHERAI_API_KEY=wai_your_key_here
WEATHERAI_BASE_URL=https://api.weather-ai.co

# Explicit frontend origins only. No wildcard *. Comma-separated or JSON list.
# Local:
CORS_ORIGINS=["http://localhost:3000"]
# Production: set to the real HTTPS frontend origin once it exists, e.g.
# CORS_ORIGINS=https://your-app.vercel.app

# Uncached WeatherAI calls per identity (client IP) per window.
# Cache HITs do not consume this budget. Process-local only.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Consecutive qualifying WeatherAI failures (500/503/timeout/network)
# after retries, per process. Cache HITs still succeed while OPEN.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30
